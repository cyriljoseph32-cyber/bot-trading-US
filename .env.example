# ─── Signal Bot US — variables d'environnement ────────────────────────────
# Copier en .env (local) et/ou renseigner dans Vercel → Settings → Env Vars.
# AUCUN secret ne doit être commité. .env est ignoré par git.

# ── Sécurité du dashboard (Phase 0) ───────────────────────────────────────
# Token protégeant /api/positions ET /api/chat (REQUIS : ces endpoints sont
# refusés tant qu'il est absent — /api/chat consomme la clé Anthropic).
# Génère une valeur longue et aléatoire, ex : openssl rand -hex 32
DASHBOARD_TOKEN=

# Protège /api/cron (Vercel Cron l'envoie automatiquement). Recommandé.
CRON_SECRET=

# ── Données marché & alertes ──────────────────────────────────────────────
# Alertes email via https://resend.com (gratuit pour démarrer)
RESEND_API_KEY=
ALERT_EMAIL=
EMAIL_FROM=onboarding@resend.dev
# true = email quotidien même sans signal
ALERT_ALWAYS=

# ── Courtier Alpaca (https://alpaca.markets) ──────────────────────────────
# Clés API. Par défaut = PAPER TRADING (argent fictif). Sûr.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# true = le bot passe les ordres lui-même (achat marché + stop attaché)
AUTOTRADE=
# true = COMPTE RÉEL. NE PAS activer avant des semaines de paper trading validé.
ALPACA_LIVE=

# ── Paramètres de risque (Phase 1 — moteur de risque) ─────────────────────
# Risque par trade en % du compte (borné 0.1–5). Défaut 1.
RISK_PCT=1
# Perte max du jour en % : au-delà, plus aucune NOUVELLE entrée (sorties OK). Défaut 3.
MAX_DAILY_LOSS_PCT=3
# Nombre max de positions simultanées. Défaut 5.
MAX_OPEN_POSITIONS=5
# Nombre max d'entrées par jour (anti-sur-trading). Défaut 3.
MAX_TRADES_PER_DAY=3
# Taille max d'une position en % du compte (anti-concentration). Défaut 20.
MAX_POSITION_PCT=20
# Exposition brute max (somme des positions) en % du compte (anti-corrélation). Défaut 70.
MAX_GROSS_EXPOSURE_PCT=70
# Plafond de slippage à l'achat : ordre limite = close × (1 + x%). Défaut 0.5.
MAX_ENTRY_SLIPPAGE_PCT=0.5
# Arrêt d'urgence : "true" = aucune nouvelle entrée (les sorties restent actives).
KILL_SWITCH=
# Capital de référence pour les emails sans Alpaca. Défaut 10000.
DEFAULT_CAPITAL=10000

# URL publique du site (lien "ouvrir le dashboard" dans l'email)
APP_URL=

# ── Base de données (Phase 0.4 — Supabase) ────────────────────────────────
# Renseignées à l'étape base de données / journal de trades.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Assistant conversationnel (/api/chat) ─────────────────────────────────
# Clé API Anthropic (https://console.anthropic.com). Requise pour l'assistant.
ANTHROPIC_API_KEY=

# ── Bot global multi-actifs (bot/) — voir bot/README.md ───────────────────
# Clé API Twelve Data (https://twelvedata.com) : flux WebSocket + REST.
# Sans elle, le bot démarre en mode dégradé (dashboard OK, pas de flux).
TWELVEDATA_API_KEY=
# ⚠ "true" = AUTORISE un adaptateur de courtier RÉEL. Jamais par défaut.
#    Aucun adaptateur réel n'est fourni : tout reste en paper trading.
LIVE_TRADING=
# Devise de base du portefeuille papier. Défaut USD.
BASE_CURRENCY=USD
# Capital de départ du portefeuille papier. Défaut 100000.
PAPER_CAPITAL=100000
# Port du dashboard/API du bot. Défaut 8787 (écoute 127.0.0.1 ; BOT_BIND pour LAN).
BOT_PORT=8787
BOT_BIND=
# Limites du plan Twelve Data (offre gratuite : 8 crédits REST/min, 8 symboles WS).
TD_REST_RPM=8
TD_WS_SYMBOL_LIMIT=8
# "true" = reclasse l'univers par liquidité via l'API (coûte des crédits REST).
UNIVERSE_DYNAMIC=
# Répertoire de persistance JSONL. Défaut data/ (gitignoré).
BOT_DATA_DIR=

# ── SPC FX5 Multi-Asset 100 (npm run bot:spcfx5) ──────────────────────────
# Watchlist et paramètres. Défaut : bot/config/spcfx5.json
SPC_CONFIG=
# Plafond d'actifs scannés. Défaut 100 dans le code, mais ⚠ CRÉDITS :
# 1 actif scanné en H1 = 24 crédits REST/jour (1 requête/heure). L'offre
# gratuite Twelve Data plafonne à 800/jour, soit 33 actifs max (33×24=792).
# La config bot/config/spcfx5.json est déjà curée à 33 actifs "enabled:true"
# diversifiés (FX majeures, indices US, métaux, crypto, actions multi-secteurs)
# pour tenir sous ce plafond — mettez cette valeur à 33 tant que vous êtes
# sur l'offre gratuite. Si vous passez sur un plan payant, remontez cette
# valeur ET repassez à enabled:true les actifs voulus dans spcfx5.json.
SPC_MAX_SYMBOLS=33
# Fichier JSON des annonces macro à fort impact (format : bot/config/news.example.json).
# Absent = filtre news neutre, la stratégie fonctionne quand même.
SPC_NEWS_FILE=
# "false" = désactive le filtre de session (utile pour un backtest). Défaut : actif.
SPC_SESSION_FILTER=
# URL de webhook pour publier les signaux retenus (optionnel).
SPC_WEBHOOK_URL=
